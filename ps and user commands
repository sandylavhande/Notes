head -n 5 <filename> # print the first 5 lines of the specified file
tail -n5 <filename> #The space between -n and the number is optional — tail -n 5 and tail -n5 work the same.

Process Related commands 
ps # Process Status — it shows currently running processes --> display active processes
ps -e # Shows all processes running on the system (not just your terminal)
ps -ef # show all processes & show them in full detailed format
ps -f # Shows a detailed list — but only for your current shell
ps -eaf # full, detailed view of all processes — like a tree structure, shows all processes, all users, full details, and parent/child relationships
ps -p <pid> #Shows info for a specific process ID
ps axjf	# Shows process tree (like a hierarchy)
ps -eo pid,ppid,cmd,%mem,%cpu --sort=-%cpu	#Shows CPU/memory usage sorted by CPU
ps -eo pid,cmd # ps -eo pid,cmd
ps -C nginx # Find process by name

cat /etc/os-release # shows detailed information about the operating system you’re running — such as name, version, ID, and version code name
